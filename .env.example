# PayPal sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client id, exposed to the browser for the PayPal JS SDK
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Claude API key (platform.claude.com)
ANTHROPIC_API_KEY=

# Random string used to sign quotes so the browser can't change held amounts
QUOTE_SIGNING_SECRET=

# Optional: cap on AI calls per IP per hour on a public deployment
AI_CALLS_PER_HOUR=30
